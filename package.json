{
  "name": "gestionale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
  "electron:build": "next build && electron-builder"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18"
  },
  "main": "electron/main.js",
"build": {
  "appId": "com.tuonome.businesshub",
  "productName": "Business Hub",
  "win": { "target": "nsis" },
  "files": [
    "electron/**",
    ".next/**",
    "public/**",
    "node_modules/**",
    "package.json",
    "next.config.*",
    "app/**",
    "components/**",
    "hooks/**",
    "lib/**",
    "types/**"
  ]
},
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "concurrently": "^10.0.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  }
}
